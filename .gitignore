# Git에서 무시할 파일들

# 파일명에 #이 포함된 파일들 (임시 파일, 백업 파일 등)
*#*

# Node.js 관련
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 빌드 결과물
dist/
build/
*.tsbuildinfo

# 환경 설정 파일
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 로그 파일
*.log

# 런타임 데이터
pids
*.pid
*.seed
*.pid.lock

# 커버리지 디렉토리
coverage/
*.lcov

# nyc 테스트 커버리지
.nyc_output

# Grunt 중간 저장소
.grunt

# Bower 의존성 디렉토리
bower_components

# node-waf 설정
.lock-wscript

# 컴파일된 바이너리 애드온
build/Release

# 의존성 디렉토리
jspm_packages/

# TypeScript v1 선언 파일
*.tsbuildinfo

# Optional npm 캐시 디렉토리
.npm

# Optional eslint 캐시
.eslintcache

# Microbundle 캐시
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL 히스토리
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity 파일
.yarn-integrity

# dotenv 환경 변수 파일
.env.test

# parcel-bundler 캐시
.cache
.parcel-cache

# Next.js 빌드 출력
.next

# Nuxt.js 빌드 / 생성 출력
.nuxt
dist

# Gatsby 파일
.cache/
public

# Storybook 빌드 출력
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
